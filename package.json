{
  "name": "genesis-miner-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint server tests --max-warnings=0",
    "test": "vitest run",
    "test:pg-integration": "vitest run --config vitest.pg-integration.config.ts",
    "i18n:scan": "node scripts/i18n-hardcode-scan.mjs",
    "i18n:scan:all": "node scripts/i18n-hardcode-scan.mjs --all",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "dev:server": "npm run build && node dist/bootstrap/server.js",
    "start": "node dist/bootstrap/server.js",
    "db:perf-indexes:verify": "bash scripts/apply-perf-hotpath-indexes.sh verify",
    "db:perf-indexes:apply-sql": "CONFIRM=1 bash scripts/apply-perf-hotpath-indexes.sh apply-sql",
    "build:rust": "bash scripts/build-rust-native.sh",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml --workspace"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "multer": "^2.2.0",
    "pg": "^8.20.0",
    "prisma": "^6.19.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.8.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
