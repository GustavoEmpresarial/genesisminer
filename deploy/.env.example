# Copiar para deploy/.env na VM. NUNCA commitar valores reais.
# Reutilizar as chaves do app_production/.env da VM (JWT, mail, RPC, Etherscan).
# DATABASE_URL / REDIS_URL são injectados pelo compose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minestation

NODE_ENV=production
FRONTEND_URL=https://dev.genesisdao.tech
CORS_EXTRA_ORIGINS=https://dev.genesisdao.tech
JWT_SECRET=change-me-long-random
POLYGON_RPC=

# SMTP (auth worker). Pick ONE consistent pair:
#   - 587 + MAIL_SECURE=0 → STARTTLS (default below)
#   - 465 + MAIL_SECURE=1 → SMTPS Wrapper
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=0
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Cloudflare Turnstile
#   app:    CLOUDFLARE_TURNSTILE_ENABLED + CLOUDFLARE_TURNSTILE_SITE_KEY (widget)
#   auth:   CLOUDFLARE_TURNSTILE_ENABLED + CLOUDFLARE_TURNSTILE_SECRET_KEY (siteverify)
# ENABLED must match on both. Misconfigured (ENABLED=1 without secret on auth) → 503.
CLOUDFLARE_TURNSTILE_ENABLED=0
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

ETHERSCAN_API_KEY=
ACCOUNT_MANAGER_ENABLED=0

# Shared secret: Node `app` ↔ Rust `mining-worker` (header x-mining-worker-token).
# Required in production Compose — generate a long random value.
MINING_WORKER_AUTH_TOKEN=change-me-mining-worker-token

# OpenCode Go — análise IA da Calculadora (só servidor; nunca no client)
OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MODEL=mimo-v2.5

# --- DB backups (genesis-mining-worker) ---
# Age-based retention for auto dumps (pg_dump -Fc). Newest is always kept.
BACKUP_RETENTION_DAYS=3
# Off-site copy to Google Drive. Leave blank to disable. 100% free (personal
# Gmail, 15 GB). Get these once:
#  1. console.cloud.google.com -> new project -> enable "Google Drive API"
#  2. OAuth consent screen (External, Testing) -> add your Gmail as a test user
#  3. Credentials -> OAuth client ID -> type "Desktop app" -> copy id + secret
#  4. one-time consent (scope https://www.googleapis.com/auth/drive.file) to get
#     a refresh token; e.g. https://developers.google.com/oauthplayground
#     (gear -> "Use your own OAuth credentials")
#  5. create a Drive folder for the backups, open it, copy the id from the URL
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_BACKUP_FOLDER_ID=
# GDRIVE_RETENTION_DAYS=   # defaults to BACKUP_RETENTION_DAYS
